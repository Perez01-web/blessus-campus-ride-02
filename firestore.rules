rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection: users/{uid}
    match /users/{uid} {
      // Users can read and manage their own user document
      allow read: if isSignedIn() && (request.auth.uid == uid || resource.data.uid == request.auth.uid);
      allow create: if isSignedIn() && request.auth.uid == uid && request.resource.data.uid == uid;
      allow update: if isOwner(uid) && request.resource.data.uid == uid;
      allow delete: if false;
    }

    // Providers Collection: providers/{providerId}
    match /providers/{providerId} {
      // Authenticated users (students & providers) can read provider profiles
      allow read: if isSignedIn();
      // Only the provider can create or update their own provider profile
      allow create: if isOwner(providerId) && request.resource.data.providerId == providerId;
      allow update: if isOwner(providerId) && request.resource.data.providerId == providerId;
      allow delete: if false;
    }

    // Schedules Collection: schedules/{scheduleId}
    match /schedules/{scheduleId} {
      // Authenticated users can browse schedules
      allow read: if isSignedIn();
      // Providers can manage their own schedules
      allow create: if isSignedIn() && request.resource.data.providerId == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.providerId == request.auth.uid || request.resource.data.providerId == request.auth.uid);
      allow delete: if isSignedIn() && resource.data.providerId == request.auth.uid;
    }

    // Bookings Collection: bookings/{bookingId}
    match /bookings/{bookingId} {
      // The student who made the booking and the provider who received it
      // can both read it. Queries are filtered on studentId or providerId,
      // which is what makes these reads safe.
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.providerId == request.auth.uid
      );

      // Only a signed-in student can create a booking, and only for
      // themselves. New bookings always start as pending.
      allow create: if isSignedIn()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.providerId is string
        && request.resource.data.pickupTime is string;

      // The parties on a booking can never be swapped, and the agreed fare
      // is locked once the request exists.
      allow update: if isSignedIn()
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.providerId == resource.data.providerId
        && request.resource.data.fare == resource.data.fare
        && (
          // Students may only cancel their own request.
          (resource.data.studentId == request.auth.uid
            && request.resource.data.status == 'cancelled')
          ||
          // Providers may only move their own bookings to a final state.
          (resource.data.providerId == request.auth.uid
            && request.resource.data.status in ['accepted', 'rejected', 'completed'])
        );

      allow delete: if false;
    }
  }
}

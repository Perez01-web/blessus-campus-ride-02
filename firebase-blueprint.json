{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile document storing basic account and role info",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Authentication User ID"
        },
        "name": {
          "type": "string",
          "description": "User full name"
        },
        "email": {
          "type": "string",
          "description": "User email address"
        },
        "phone": {
          "type": "string",
          "description": "Contact phone number"
        },
        "role": {
          "type": "string",
          "enum": ["student", "provider"],
          "description": "Account role"
        },
        "providerType": {
          "type": "string",
          "enum": ["taxi", "motorbike"],
          "description": "Service vehicle type for providers"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of account creation"
        }
      },
      "required": ["uid", "name", "email", "role", "createdAt"]
    },
    "Provider": {
      "title": "Provider",
      "description": "Transport provider operational details, pricing, vehicle, and status",
      "type": "object",
      "properties": {
        "providerId": {
          "type": "string",
          "description": "Provider ID matching the user UID"
        },
        "userId": {
          "type": "string",
          "description": "User ID of the provider"
        },
        "name": {
          "type": "string",
          "description": "Provider display name"
        },
        "providerType": {
          "type": "string",
          "enum": ["taxi", "motorbike"],
          "description": "Vehicle service type"
        },
        "phone": {
          "type": "string",
          "description": "Contact phone number"
        },
        "vehicleName": {
          "type": "string",
          "description": "Vehicle make and model"
        },
        "vehicleRegistration": {
          "type": "string",
          "description": "Registration plate number"
        },
        "price": {
          "type": "number",
          "description": "Standard trip price in MWK"
        },
        "estimatedWaitTime": {
          "type": "number",
          "description": "Average pickup wait time in minutes"
        },
        "available": {
          "type": "boolean",
          "description": "Current availability for rides"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of record creation"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of record update"
        }
      },
      "required": ["providerId", "userId", "name", "providerType", "price", "available", "createdAt", "updatedAt"]
    },
    "Booking": {
      "title": "Booking",
      "description": "A ride request made by a student for a specific provider at a specific pickup time",
      "type": "object",
      "properties": {
        "bookingId": {
          "type": "string",
          "description": "Unique booking identifier (also the document id)"
        },
        "studentId": {
          "type": "string",
          "description": "UID of the student who placed the booking"
        },
        "studentName": {
          "type": "string",
          "description": "Student display name at time of booking"
        },
        "studentPhone": {
          "type": "string",
          "description": "Student contact number"
        },
        "providerId": {
          "type": "string",
          "description": "UID of the booked provider"
        },
        "providerName": {
          "type": "string",
          "description": "Provider display name at time of booking"
        },
        "providerPhone": {
          "type": "string",
          "description": "Provider contact number so the student can call the driver"
        },
        "providerType": {
          "type": "string",
          "enum": ["taxi", "motorbike"],
          "description": "Service type of the booked provider"
        },
        "vehicleName": {
          "type": "string",
          "description": "Vehicle of the booked provider"
        },
        "pickupTime": {
          "type": "string",
          "description": "ISO timestamp for the scheduled pickup"
        },
        "fare": {
          "type": "number",
          "description": "Agreed trip fare in MWK"
        },
        "estimatedWaitTime": {
          "type": "number",
          "description": "Provider average pickup wait time in minutes"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "accepted", "rejected", "completed", "cancelled"],
          "description": "Current booking status"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of booking creation"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last status change"
        }
      },
      "required": ["bookingId", "studentId", "providerId", "pickupTime", "fare", "status", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "User",
      "description": "Stores user profiles with role definitions"
    },
    "/providers/{providerId}": {
      "schema": "Provider",
      "description": "Stores provider vehicle, availability, and pricing details"
    },
    "/bookings/{bookingId}": {
      "schema": "Booking",
      "description": "Stores ride requests linking a student to a provider at a scheduled pickup time"
    }
  }
}

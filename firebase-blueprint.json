{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile document storing basic account and role info",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Authentication User ID"
        },
        "name": {
          "type": "string",
          "description": "User full name"
        },
        "email": {
          "type": "string",
          "description": "User email address"
        },
        "phone": {
          "type": "string",
          "description": "Contact phone number"
        },
        "role": {
          "type": "string",
          "enum": ["student", "provider"],
          "description": "Account role"
        },
        "providerType": {
          "type": "string",
          "enum": ["taxi", "motorbike"],
          "description": "Service vehicle type for providers"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of account creation"
        }
      },
      "required": ["uid", "name", "email", "role", "createdAt"]
    },
    "Provider": {
      "title": "Provider",
      "description": "Transport provider operational details, pricing, vehicle, and status",
      "type": "object",
      "properties": {
        "providerId": {
          "type": "string",
          "description": "Provider ID matching the user UID"
        },
        "userId": {
          "type": "string",
          "description": "User ID of the provider"
        },
        "name": {
          "type": "string",
          "description": "Provider display name"
        },
        "providerType": {
          "type": "string",
          "enum": ["taxi", "motorbike"],
          "description": "Vehicle service type"
        },
        "phone": {
          "type": "string",
          "description": "Contact phone number"
        },
        "vehicleName": {
          "type": "string",
          "description": "Vehicle make and model"
        },
        "vehicleRegistration": {
          "type": "string",
          "description": "Registration plate number"
        },
        "price": {
          "type": "number",
          "description": "Standard trip price in MWK"
        },
        "estimatedWaitTime": {
          "type": "number",
          "description": "Average pickup wait time in minutes"
        },
        "available": {
          "type": "boolean",
          "description": "Current availability for rides"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of record creation"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of record update"
        }
      },
      "required": ["providerId", "userId", "name", "providerType", "price", "available", "createdAt", "updatedAt"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Transport ride bookings between students and providers",
      "type": "object",
      "properties": {
        "bookingId": { "type": "string", "description": "Unique booking identifier" },
        "studentId": { "type": "string", "description": "Student UID" },
        "studentName": { "type": "string", "description": "Student full name" },
        "studentPhone": { "type": "string", "description": "Student contact number" },
        "providerId": { "type": "string", "description": "Provider UID" },
        "providerName": { "type": "string", "description": "Provider full name" },
        "providerType": { "type": "string", "enum": ["taxi", "motorbike"], "description": "Vehicle service type" },
        "providerPhone": { "type": "string", "description": "Provider phone number" },
        "vehicleName": { "type": "string", "description": "Vehicle make/model" },
        "vehicleRegistration": { "type": "string", "description": "Vehicle registration plate" },
        "pickupLocation": { "type": "string", "description": "Pickup point on campus or vicinity" },
        "destination": { "type": "string", "description": "Destination location" },
        "fare": { "type": "number", "description": "Agreed fare in MWK" },
        "paymentMethod": { "type": "string", "enum": ["cash", "airtel_money", "mpamba"], "description": "Payment method" },
        "notes": { "type": "string", "description": "Additional notes or instructions" },
        "status": { "type": "string", "enum": ["pending", "accepted", "in_progress", "completed", "cancelled"], "description": "Trip booking state" },
        "createdAt": { "type": "string", "description": "ISO timestamp of booking" },
        "updatedAt": { "type": "string", "description": "ISO timestamp of status update" }
      },
      "required": ["bookingId", "studentId", "studentName", "providerId", "providerName", "pickupLocation", "destination", "fare", "status", "createdAt"]
    },
    "Schedule": {
      "title": "Schedule",
      "description": "Provider operating schedule and route preferences",
      "type": "object",
      "properties": {
        "scheduleId": { "type": "string", "description": "Schedule document ID" },
        "providerId": { "type": "string", "description": "Provider UID" },
        "startTime": { "type": "string", "description": "Daily operational start time (e.g. 06:00)" },
        "endTime": { "type": "string", "description": "Daily operational end time (e.g. 21:00)" },
        "operatingDays": { "type": "array", "items": { "type": "string" }, "description": "Active days of the week" },
        "activeRoutes": { "type": "array", "items": { "type": "string" }, "description": "Preferred campus routes" },
        "updatedAt": { "type": "string", "description": "ISO timestamp of update" }
      },
      "required": ["providerId", "startTime", "endTime"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "User",
      "description": "Stores user profiles with role definitions"
    },
    "/providers/{providerId}": {
      "schema": "Provider",
      "description": "Stores provider vehicle, availability, and pricing details"
    },
    "/bookings/{bookingId}": {
      "schema": "Booking",
      "description": "Stores ride booking requests and real-time trip statuses"
    },
    "/schedules/{scheduleId}": {
      "schema": "Schedule",
      "description": "Stores provider daily shift schedules and active operating routes"
    }
  }
}
